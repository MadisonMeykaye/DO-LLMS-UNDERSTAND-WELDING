# 默认忽略所有文件
*

# 但保留 .gitignore 自身
!.gitignore

# 允许 finetune 整个目录
!finetune/
!finetune/**/*

# 允许 results_lora_realworld 整个目录
!results_lora_realworld/
!results_lora_realworld/**/*

# 允许 results_clean_noprompt 目录，但只保留 .xlsx 文件
!results_clean_noprompt/
!results_clean_noprompt/**/
!results_clean_noprompt/**/*.xlsx

# 允许 results_lora_realworld_weldprompt 目录，但只保留 .xlsx 文件
!results_lora_realworld_weldprompt/
!results_lora_realworld_weldprompt/**/
!results_lora_realworld_weldprompt/**/*.xlsx

# 显式忽略不需要上传的目录
.devcontainer/
.vscode/
llava-env/
remote_scripts/
results/
results-private/
results.gpt/
vim_devenv/
data/
scripts/

# 敏感文件
secrets.jsonc

# 临时文件
__pycache__/
*.pyc
.DS_Store
*.log
*.whl
*.wlh